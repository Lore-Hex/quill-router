  "rules": [
    {
      "name": "candidate_provider_identity",
      "rule": "Candidate.provider: binds Identity",
      "cases": [
        "candidate_provider_ascii",
        "candidate_provider_identity_punctuation"
      ],
      "old": "    provider: Identity",
      "new": "    provider: Annotated[str, Field(min_length=1, max_length=512)]",
      "scope": "Candidate"
    },
    {
      "name": "candidate_provider_min",
      "rule": "Candidate.provider: Identity min length",
      "cases": [
        "candidate_provider_min"
      ],
      "old": "    provider: Identity",
      "new": "    provider: Annotated[str, Field(max_length=512, pattern=r\"^[A-Za-z0-9_./:@+\\-]*$\")]",
      "scope": "Candidate"
    },
    {
      "name": "candidate_provider_max",
      "rule": "Candidate.provider: Identity max length",
      "cases": [
        "candidate_provider_max"
      ],
      "old": "    provider: Identity",
      "new": "    provider: Annotated[str, Field(min_length=1, pattern=r\"^[A-Za-z0-9_./:@+\\-]+$\")]",
      "scope": "Candidate"
    },
    {
      "name": "candidate_provider_required",
      "rule": "Candidate.provider: required",
      "cases": [
        "candidate_provider_required"
      ],
      "old": "    provider: Identity",
      "new": "    provider: Identity = 'openai'",
      "scope": "Candidate"
    },
    {
      "name": "candidate_provider_nonnull",
      "rule": "Candidate.provider: nonnull Identity",
      "cases": [
        "candidate_provider_nonnull_null"
      ],
      "old": "    provider: Identity",
      "new": "    provider: (Identity) | None",
      "scope": "Candidate"
    },
    {
      "name": "candidate_provider_string_type",
      "rule": "Candidate.provider: string input type",
      "cases": [
        "candidate_provider_string_type"
      ],
      "old": "    provider: Identity",
      "new": "    provider: Identity | int",
      "scope": "Candidate"
    },
    {
      "name": "candidate_provider_any_slug",
      "rule": "Any provider slug is accepted, with no adapter list",
      "cases": [
        "candidate_provider_any_slug",
        "reseller_cache"
      ],
      "old": "    provider: Identity",
      "new": "    provider: Literal[\"openai\", \"anthropic\"]",
      "scope": "Candidate",
      "failure": "rejected_positive"
    },
    {
      "name": "candidate_model_any_publisher",
      "rule": "A provider may serve another publisher's model, with no provider/ prefix rule",
      "cases": [
        "candidate_model_any_publisher",
        "reseller_cache",
        "bedrock_anthropic_cache"
      ],
      "old": "            raise ValueError(\"unsupported prompt convention for adapter\")\n",
      "new": "            raise ValueError(\"unsupported prompt convention for adapter\")\n        if not self.model_id.startswith(self.provider + \"/\"):\n            raise ValueError(\"custom or unsupported model\")\n",
      "scope": "Candidate",
      "failure": "rejected_positive"
    },
    {
      "name": "convention_not_by_publisher_alone",
      "rule": "Prompt convention is not the model publisher's alone: only anthropic, amazon-bedrock and google-vertex exclude cached tokens for an anthropic/ model",
      "cases": [
        "other_provider_anthropic_model_prompt_agreement"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "self.model_id.startswith(\"anthropic/\")",
      "scope": "Candidate"
    },
    {
      "name": "convention_not_by_publisher_alone_positive",
      "rule": "Another provider serving an anthropic/ model keeps the cache-inclusive convention",
      "cases": [
        "candidate_model_any_publisher"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "self.model_id.startswith(\"anthropic/\")",
      "scope": "Candidate",
      "failure": "rejected_positive"
    },
    {
      "name": "convention_not_by_slug_alone",
      "rule": "Prompt convention is not the provider slug's alone: amazon-bedrock and google-vertex exclude cached tokens for an anthropic/ model",
      "cases": [
        "bedrock_anthropic_prompt_agreement",
        "vertex_anthropic_prompt_agreement"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "provider_input_excludes_cache(self.provider)",
      "scope": "Candidate"
    },
    {
      "name": "convention_not_by_slug_alone_positive",
      "rule": "A reseller relaying Anthropic-native usage for an anthropic/ model is cache-exclusive",
      "cases": [
        "bedrock_anthropic_cache",
        "vertex_anthropic_cache",
        "mixed_providers_tiered_reseller"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "provider_input_excludes_cache(self.provider)",
      "scope": "Candidate",
      "failure": "rejected_positive"
    },
    {
      "name": "convention_not_by_reseller_alone",
      "rule": "Prompt convention is not the reseller's alone: amazon-bedrock serving another publisher's model is cache-inclusive",
      "cases": [
        "bedrock_other_publisher_prompt_agreement"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "self.provider in (\"anthropic\", \"amazon-bedrock\", \"google-vertex\")",
      "scope": "Candidate"
    },
    {
      "name": "convention_not_by_reseller_alone_positive",
      "rule": "A reseller serving another publisher's model keeps the cache-inclusive convention",
      "cases": [
        "bedrock_other_publisher_cache"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "self.provider in (\"anthropic\", \"amazon-bedrock\", \"google-vertex\")",
      "scope": "Candidate",
      "failure": "rejected_positive"
    },
    {
      "name": "convention_not_always_exclusive",
      "rule": "A provider outside the rule claiming the cache-exclusive convention is refused",
      "cases": [
        "reseller_prompt_agreement"
      ],
      "old": "provider_input_excludes_cache(self.provider, self.model_id)",
      "new": "True",
      "scope": "Candidate"
    },
    {
      "name": "builder_convention_follows_provider_and_model",
      "rule": "build_snapshot derives the convention from the provider slug and the model id",
      "cases": [
        "builder_reseller_convention"
      ],
      "old": "\"excludes_cache\" if provider_input_excludes_cache(endpoint.provider, endpoint.model_id)",
      "new": "\"excludes_cache\" if provider_input_excludes_cache(endpoint.provider)",
      "failure": "rejected_positive"
    },
    {
      "name": "builder_convention_not_by_publisher",
      "rule": "build_snapshot does not derive the convention from the model publisher alone",
      "cases": [
        "builder_reseller_other_publisher"
      ],
      "old": "\"excludes_cache\" if provider_input_excludes_cache(endpoint.provider, endpoint.model_id)",
      "new": "\"excludes_cache\" if endpoint.provider in (\"anthropic\", \"amazon-bedrock\", \"google-vertex\")",
      "failure": "rejected_positive"
    },
    {
      "name": "user_model_identity_fact",
      "rule": "A user-model identity is excluded by the user_model fact, in both phases",
      "cases": [
        "user_model_identity_requested",
        "user_model_identity_observed"
      ],
      "old": "if getattr(context, name):",
      "new": "if name != \"user_model\" and getattr(context, name):"
    }
  ]
}
