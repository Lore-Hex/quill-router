[Unit]
Description=TrustedRouter Postgres to ClickHouse delivery verification (AWS-EU)
After=network-online.target clickhouse-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=tr-clickhouse-ingest
Group=tr-clickhouse-ingest
# The flat layout the drain installer ships: no PYTHONPATH, `python -m` sees
# WorkingDirectory only. HOME inside ReadWritePaths for the same libpq
# client-certificate reason the drain unit documents.
WorkingDirectory=/opt/tr-clickhouse
Environment=HOME=/var/lib/tr-clickhouse-ingest
# The drain's file supplies TR_POSTGRES_IAM_AUTH/_REGION, CH_PASSWORD and the
# ClickHouse user and database. The second file, written after it, carries only
# TR_POSTGRES_DSN with user=tr_verifier and overrides the drain's DSN; it holds
# no secret, because DSQL mints the token per connection.
EnvironmentFile=/etc/tr-clickhouse-ingest-postgres.env
EnvironmentFile=/etc/tr-clickhouse-postgres-delivery.env
# Exit 0 only for a complete, clean check. Each completed check appends its
# summary to the history file (16 days kept) and prints the same JSON line to
# the journal.
#
# --scan-limit must exceed the plane's TOTAL generation-entity count: until a
# generation timestamp index exists the source scan walks all history by
# primary key, and a capped scan reports complete=false and exits 1 every run.
# A complete run's "scanned" field is that count; raise this well before it
# gets close. --limit (default 5000) separately caps the generations compared
# in one 24 h window, with the same complete=false outcome.
ExecStart=/opt/tr-clickhouse/venv/bin/python -m clickhouse.verify_postgres_delivery --lookback-hours 24 --scan-limit 1000000 --history-file /var/lib/tr-clickhouse-ingest/postgres-delivery-aws.jsonl
# A full scan is 2000 primary-key pages of 500 at this cap.
TimeoutStartSec=20m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tr-clickhouse-ingest
