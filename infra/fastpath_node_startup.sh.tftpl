#!/bin/bash
# The fast path's node: installs the release the instance's metadata names
# (fastpath-release, a commit on main whose CI passed, built and uploaded by
# .github/workflows/fastpath-release.yml) and runs it as the systemd unit
# `fastpath`, which docs/runbooks/fastpath-deploy.md marks leaving and stops.
set -euo pipefail
# The node's journal reaches Cloud Logging through the Ops Agent, set up
# before anything else so a node with no release, or one whose release
# fails to install, still says why there. The unit writes its alerts as
# structured JSON lines (fastpath_alert in the entry's labels, the alert's
# severity), which W7's alerting reads in Cloud Logging; without the agent
# they stop in journald, as P1's second run found. The install is
# idempotent. The journal's line is its MESSAGE field; parsed, its
# "logging.googleapis.com/labels" become the entry's labels and its
# "severity", promoted, the entry's severity.
if ! systemctl is-active --quiet google-cloud-ops-agent 2>/dev/null; then
  curl -sSfo /tmp/add-ops-agent-repo.sh https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
  bash /tmp/add-ops-agent-repo.sh --also-install
fi
install -d /etc/google-cloud-ops-agent
cat > /etc/google-cloud-ops-agent/config.yaml <<AGENT
logging:
  receivers:
    fastpath_journal:
      type: systemd_journald
  processors:
    fastpath_json:
      type: parse_json
      field: MESSAGE
    fastpath_fields:
      type: modify_fields
      fields:
        severity:
          move_from: jsonPayload.severity
        labels."unit":
          move_from: jsonPayload._SYSTEMD_UNIT
  service:
    pipelines:
      fastpath:
        receivers: [fastpath_journal]
        processors: [fastpath_json, fastpath_fields]
AGENT
systemctl restart google-cloud-ops-agent
release="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/attributes/fastpath-release' || true)"
if [ -z "$release" ]; then
  echo "fastpath: no release pinned in the instance's metadata; the node stays stopped" | systemd-cat -t fastpath -p warning
  exit 0
fi
address="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip'):8080"
install -d /opt/fastpath
for binary in fastpath fastpathctl; do
  gcloud storage cp "gs://${release_bucket}/fastpath/$release/$binary" "/opt/fastpath/$binary.new"
  chmod 0755 "/opt/fastpath/$binary.new"
  mv "/opt/fastpath/$binary.new" "/opt/fastpath/$binary"
done
# The load generator, its mix and the watch (rollout P1) ride with releases
# from P1 on; a release without them still runs the node.
for tool in loadgen fastpathwatch load-mix.json; do
  if gcloud storage cp "gs://${release_bucket}/fastpath/$release/$tool" "/opt/fastpath/$tool.new"; then
    chmod 0755 "/opt/fastpath/$tool.new"
    mv "/opt/fastpath/$tool.new" "/opt/fastpath/$tool"
  else
    echo "fastpath: release $release carries no $tool; P1's tools are not installed" | systemd-cat -t fastpath -p warning
  fi
done
echo "$release" > /opt/fastpath/release
cat > /etc/systemd/system/fastpath.service <<UNIT
[Unit]
Description=TrustedRouter fast admission node ($release)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/fastpath/fastpath \
  -roles admission,auditor \
  -address $address \
  -region ${region} \
  -database ${database} \
  -project ${project} \
  -key-secret ${key_secret} \
  -topics settle-log,records \
  -subscriptions auditor,stager
# SIGUSR1 marks the node leaving (the deploy runbook); SIGTERM stops it.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now fastpath
