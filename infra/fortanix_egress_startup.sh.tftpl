#!/bin/bash
# The Fortanix egress VM (infra/fortanix_egress.tf). The VPC routes the
# attested gateways' connections to Fortanix here; this forwards them,
# rewritten to this VM's internal address, so they leave from its reserved
# external address, which Fortanix allow-lists. Nothing else is forwarded.
#
# Only the gateways' packets to Fortanix are routed here. Until the rules
# below load, such a packet keeps its gateway's private source address and
# cannot leave from this VM's address, so missing rules stop Fortanix traffic
# and expose nothing else. The rules are rebuilt on every boot.
set -euo pipefail

# Without nftables there are no rules to load, so this retries until the
# install succeeds.
until command -v nft > /dev/null; do
  apt-get update -q && apt-get install -y -q nftables || sleep 30
done

# Forwarding is closed by default: only a new connection from the VPC to a
# Fortanix address on port 443, and the packets of connections already
# admitted, pass. The VM has one interface, so the rules name none.
nft -f - <<RULES
table ip fortanix_egress
delete table ip fortanix_egress
table ip fortanix_egress {
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ip saddr ${source_range} ip daddr { ${destinations} } tcp dport 443 ct state new counter accept
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip daddr { ${destinations} } counter masquerade
  }
}
RULES

# Forwarding goes on after the rules load. The image's
# 60-gce-network-security.conf turns it off; this file sorts after it, so it
# stays on whenever the files are applied again.
echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-fortanix-egress.conf
sysctl --quiet -w net.ipv4.ip_forward=1

nft list table ip fortanix_egress
echo "fortanix-egress: forwarding to ${destinations}"
